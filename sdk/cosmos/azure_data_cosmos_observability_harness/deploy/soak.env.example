# cspell:ignore soakpool

# Copy to `soak.env` and fill in. `soak.env` is git-ignored so account details
# never land in the repo.
#
#   cp soak.env.example soak.env
#
# Only SUBSCRIPTION_ID is mandatory; everything else has a working default (see
# common.sh). Uncomment and change what you need.

# --- Required ----------------------------------------------------------------

# Subscription that will be billed for the soak (AKS + Cosmos + Azure Monitor
# workspace + Managed Grafana).
SUBSCRIPTION_ID=""

# --- Azure resources ---------------------------------------------------------

# RESOURCE_GROUP="cosmos-rust-obs-soak-rg"
# LOCATION="westus2"

# ACR names are globally unique and must be alphanumeric only.
# ACR_NAME="cosmosrustobssoakacr"
# AKS_CLUSTER="cosmos-rust-obs-soak-aks"
# AKS_NODE_COUNT="2"
# AKS_NODE_SIZE="Standard_D4s_v5"

# MONITOR_WORKSPACE="cosmos-rust-obs-soak-amw"
# GRAFANA_NAME="cosmos-rust-obs-soak-grafana"
# COSMOS_ACCOUNT="cosmos-rust-obs-soak"
# MANAGED_IDENTITY="cosmos-obs-soak-identity"

# Azure Monitor workspaces and Managed Grafana are not offered in every region
# that runs AKS. Pin these if `LOCATION` is not supported.
# MONITOR_LOCATION="westus2"
# GRAFANA_LOCATION="westus2"

# Point at an existing account instead of provisioning one. When set,
# provision-soak-infra.sh skips Cosmos creation and only assigns data-plane RBAC.
# COSMOS_ACCOUNT_RESOURCE_GROUP=""

# --- Sharing the Cosmos perf harness's cluster -------------------------------

# `./provision-soak-infra.sh --attach-to-perf` reuses the cluster, registry,
# Grafana workspace and managed identity the perf harness already deployed, so a
# new tenant is one stack instead of two. Set the perf resource group; the rest
# is discovered from it and only needs setting if that group holds more than one
# candidate.
# PERF_RESOURCE_GROUP=""
# PERF_AKS_CLUSTER=""
# PERF_ACR_NAME=""
# PERF_GRAFANA_NAME=""
# PERF_MANAGED_IDENTITY=""

# The label the perf harness puts on its pods; the soak steers away from nodes
# carrying it.
# PERF_POD_LABEL="cosmos-perf"

# The soak gets its own node pool in both modes. It never shares a node with the
# perf harness: perf pins one pod per node and tunes it to ~80% CPU, so a
# co-scheduled soak pod would distort perf's measurement and inherit the
# contention as latency noise of its own. Standalone provisioning names the
# cluster's initial pool this; --attach-to-perf adds it to the perf cluster
# tainted so only the soak lands there.
# SOAK_NODE_POOL="soakpool"
# SOAK_NODE_SIZE="Standard_D2s_v5"
# SOAK_NODE_COUNT="1"
# SOAK_NODE_TAINT_KEY="workload"
# SOAK_NODE_TAINT_VALUE="soak"

# --- Workload shape ----------------------------------------------------------

# NAMESPACE="cosmos-observability-soak"
# IMAGE_REPOSITORY="cosmos-observability-harness"
# IMAGE_TAG="latest"
# OTEL_COLLECTOR_VERSION="0.157.0"

# Distinguishes soaks that share an Azure Monitor workspace (for example a
# baseline run and a candidate-branch run).
# SOAK_ENVIRONMENT="soak"

# COSMOS_DATABASE="observability_soak"
# COSMOS_CONTAINER="items"
# COSMOS_THROUGHPUT="400"
# SEED_COUNT="500"
# CONCURRENCY="8"
# TARGET_RPS="20"
# READ_WEIGHT="70"
# WRITE_WEIGHT="20"
# QUERY_WEIGHT="10"
# METRIC_EXPORT_INTERVAL_SECS="15"

# --- Fault canary ------------------------------------------------------------

# Set FAULT_CANARY_REPLICAS=0 to disable the recurring fault window entirely.
# FAULT_CANARY_REPLICAS="1"
# FAULT_CANARY_CONCURRENCY="4"
# FAULT_CANARY_RPS="5"
# FAULT_CYCLE_SECS="900"
# FAULT_START_SECS="780"
# FAULT_DURATION_SECS="120"
# FAULT_PROBABILITY="0.25"
# FAULT_ERROR="service-unavailable"

# --- Optional ----------------------------------------------------------------

# Send the harness's spans to Application Insights so error-path traces outlive
# the pod log. Leave empty to drop traces.
# APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Cluster infrastructure scrape targets. Billed per ingested sample, and these
# are cluster-wide rather than namespace-scoped -- on a shared cluster they also
# ingest every other team's pods. Defaults below are the lean profile. Flip
# SCRAPE_CADVISOR off to roughly halve ingestion cost at the price of losing
# container-memory trend (the signal that catches an SDK leak over weeks).
# SCRAPE_CADVISOR="true"
# SCRAPE_KUBESTATE="true"
# SCRAPE_COLLECTOR_HEALTH="true"
# SCRAPE_KUBELET="false"
# SCRAPE_NODEEXPORTER="false"

# Entra security group (object id or display name) granted dashboard access by
# grant-team-access.sh.
# TEAM_ENTRA_GROUP=""
# TEAM_GRAFANA_ROLE="Grafana Viewer"
